<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>API VAPT Report — {{ scan.name }}</title>
<style>
  :root {
    --critical: #dc2626; --high: #ea580c; --medium: #d97706;
    --low: #16a34a; --info: #2563eb;
    --bg: #0f172a; --surface: #1e293b; --border: #334155;
    --text: #e2e8f0; --muted: #94a3b8;
    --accent: #6366f1;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Segoe UI', system-ui, sans-serif; background: #fff; color: #1e293b; line-height: 1.6; }
  
  .cover { background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%); color: #e2e8f0; padding: 60px 50px; min-height: 300px; }
  .cover h1 { font-size: 2.5rem; font-weight: 800; margin-bottom: 8px; }
  .cover .subtitle { color: #94a3b8; font-size: 1.1rem; }
  .cover .meta { margin-top: 30px; display: flex; gap: 40px; }
  .cover .meta-item label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: #64748b; }
  .cover .meta-item span { display: block; font-weight: 600; color: #c7d2fe; }

  .risk-badge { display: inline-block; padding: 4px 16px; border-radius: 999px; font-weight: 700; font-size: 0.9rem; margin-top: 20px; }
  .risk-CRITICAL { background: #dc2626; color: #fff; }
  .risk-HIGH { background: #ea580c; color: #fff; }
  .risk-MEDIUM { background: #d97706; color: #fff; }
  .risk-LOW { background: #16a34a; color: #fff; }
  .risk-INFO { background: #2563eb; color: #fff; }

  .section { padding: 40px 50px; }
  .section + .section { border-top: 1px solid #e2e8f0; }
  h2 { font-size: 1.4rem; font-weight: 700; color: #1e293b; margin-bottom: 20px; padding-bottom: 8px; border-bottom: 2px solid #6366f1; }
  h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 12px; color: #1e293b; }

  .summary-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
  .sev-card { text-align: center; border-radius: 12px; padding: 20px 10px; }
  .sev-card.critical { background: #fef2f2; border: 2px solid #fecaca; }
  .sev-card.high { background: #fff7ed; border: 2px solid #fed7aa; }
  .sev-card.medium { background: #fffbeb; border: 2px solid #fde68a; }
  .sev-card.low { background: #f0fdf4; border: 2px solid #bbf7d0; }
  .sev-card.info { background: #eff6ff; border: 2px solid #bfdbfe; }
  .sev-card .count { font-size: 2.5rem; font-weight: 800; }
  .sev-card.critical .count { color: #dc2626; }
  .sev-card.high .count { color: #ea580c; }
  .sev-card.medium .count { color: #d97706; }
  .sev-card.low .count { color: #16a34a; }
  .sev-card.info .count { color: #2563eb; }
  .sev-card .label { font-size: 0.85rem; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 1px; }

  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th { background: #f1f5f9; padding: 10px 14px; text-align: left; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; }
  td { padding: 10px 14px; border-top: 1px solid #e2e8f0; vertical-align: top; }
  tr:hover td { background: #f8fafc; }

  .sev-badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
  .sev-badge.critical { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
  .sev-badge.high { background: #fff7ed; color: #ea580c; border: 1px solid #fed7aa; }
  .sev-badge.medium { background: #fffbeb; color: #d97706; border: 1px solid #fde68a; }
  .sev-badge.low { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }
  .sev-badge.info { background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; }

  .finding-card { border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; margin-bottom: 24px; }
  .finding-card.critical { border-left: 4px solid #dc2626; }
  .finding-card.high { border-left: 4px solid #ea580c; }
  .finding-card.medium { border-left: 4px solid #d97706; }
  .finding-card.low { border-left: 4px solid #16a34a; }
  .finding-card.info { border-left: 4px solid #2563eb; }

  .finding-header { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .finding-title { font-size: 1.05rem; font-weight: 700; }
  .finding-endpoint { font-size: 0.85rem; color: #64748b; margin-bottom: 8px; font-family: monospace; }
  .finding-section { margin-top: 14px; }
  .finding-section label { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #6366f1; display: block; margin-bottom: 4px; }
  .finding-section p { font-size: 0.9rem; color: #374151; }
  pre { background: #0f172a; color: #e2e8f0; border-radius: 8px; padding: 14px; font-size: 0.8rem; overflow-x: auto; font-family: 'Courier New', monospace; margin-top: 6px; white-space: pre-wrap; word-break: break-all; }

  .owasp-table td:last-child { font-weight: 700; }
  .status-PASS { color: #16a34a; }
  .status-FAIL { color: #dc2626; }
  .status-NOT { color: #94a3b8; }

  .disclaimer { background: #fff7ed; border: 1px solid #fed7aa; border-radius: 8px; padding: 16px 20px; font-size: 0.85rem; color: #92400e; }

  @media print {
    .section { break-inside: avoid; }
    .finding-card { break-inside: avoid; page-break-inside: avoid; }
  }
</style>
</head>
<body>

<!-- Cover -->
<div class="cover">
  <div style="font-size:0.8rem;text-transform:uppercase;letter-spacing:2px;color:#6366f1;margin-bottom:12px;">API VAPT REPORT</div>
  <h1>{{ scan.name }}</h1>
  <div class="subtitle">Vulnerability Assessment &amp; Penetration Testing</div>
  <span class="risk-badge risk-{{ overall_risk }}">Overall Risk: {{ overall_risk }}</span>
  <div class="meta">
    <div class="meta-item"><label>Target</label><span>{{ scan.target.name }}</span></div>
    <div class="meta-item"><label>Base URL</label><span>{{ scan.target.base_url }}</span></div>
    <div class="meta-item"><label>Scan Mode</label><span>{{ scan.mode.value | upper }}</span></div>
    <div class="meta-item"><label>Generated</label><span>{{ generated_at }}</span></div>
    {% if consent %}<div class="meta-item"><label>Tester</label><span>{{ consent.tester_name }}</span></div>{% endif %}
  </div>
</div>

<!-- Disclaimer -->
<div class="section">
  <div class="disclaimer">
    ⚠️ <strong>Authorized Testing Only.</strong>
    This report was generated by an authorized security assessment conducted with explicit written consent.
    {% if consent %}Consent provided by <strong>{{ consent.tester_name }}</strong> ({{ consent.tester_email }}) on {{ consent.consented_at.strftime('%Y-%m-%d %H:%M UTC') }}.{% endif %}
    This report is confidential and intended solely for the authorized parties.
  </div>
</div>

<!-- Executive Summary -->
<div class="section">
  <h2>Executive Summary</h2>
  <div class="summary-grid">
    <div class="sev-card critical"><div class="count">{{ counts.critical }}</div><div class="label">Critical</div></div>
    <div class="sev-card high"><div class="count">{{ counts.high }}</div><div class="label">High</div></div>
    <div class="sev-card medium"><div class="count">{{ counts.medium }}</div><div class="label">Medium</div></div>
    <div class="sev-card low"><div class="count">{{ counts.low }}</div><div class="label">Low</div></div>
    <div class="sev-card info"><div class="count">{{ counts.info }}</div><div class="label">Info</div></div>
  </div>
  <p style="margin-top:20px;color:#475569;">
    A total of <strong>{{ total_findings }} findings</strong> were identified across 
    <strong>{{ endpoints | length }} endpoints</strong> tested.
    The overall risk rating is <strong>{{ overall_risk }}</strong>.
  </p>
</div>

<!-- Scope & Methodology -->
<div class="section">
  <h2>Scope &amp; Methodology</h2>
  <table>
    <tr><th>Field</th><th>Value</th></tr>
    <tr><td>Target Name</td><td>{{ scan.target.name }}</td></tr>
    <tr><td>Base URL</td><td><code>{{ scan.target.base_url }}</code></td></tr>
    <tr><td>Scan Mode</td><td>{{ scan.mode.value | upper }} mode</td></tr>
    <tr><td>Rate Limit</td><td>{{ scan.rate_limit_rps }} req/s</td></tr>
    <tr><td>Concurrency</td><td>{{ scan.concurrency }} workers</td></tr>
    <tr><td>Started</td><td>{{ scan.started_at.strftime('%Y-%m-%d %H:%M UTC') if scan.started_at else 'N/A' }}</td></tr>
    <tr><td>Completed</td><td>{{ scan.completed_at.strftime('%Y-%m-%d %H:%M UTC') if scan.completed_at else 'N/A' }}</td></tr>
    {% if consent %}
    <tr><td>Authorized By</td><td>{{ consent.tester_name }} &lt;{{ consent.tester_email }}&gt;</td></tr>
    <tr><td>Scope Description</td><td>{{ consent.scope_description }}</td></tr>
    {% endif %}
  </table>
</div>

<!-- OWASP API Top 10 Coverage -->
<div class="section">
  <h2>OWASP API Security Top 10 Coverage</h2>
  <table class="owasp-table">
    <thead><tr><th>ID</th><th>Category</th><th>Findings</th><th>Status</th></tr></thead>
    <tbody>
    {% for item in owasp_matrix %}
    <tr>
      <td><strong>{{ item.id }}</strong></td>
      <td>{{ item.title }}</td>
      <td>{{ item.findings_count }}</td>
      <td class="status-{{ item.status.split(' ')[0] }}">{{ item.status }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
</div>

<!-- Findings -->
<div class="section">
  <h2>Detailed Findings ({{ total_findings }})</h2>

  {% for f in findings %}
  <div class="finding-card {{ f.severity.value }}">
    <div class="finding-header">
      <span class="sev-badge {{ f.severity.value }}">{{ f.severity.value }}</span>
      {% if f.cvss_score > 0 %}<span style="font-size:0.85rem;color:#64748b;">CVSS {{ f.cvss_score }}</span>{% endif %}
      {% if f.owasp_id %}<span style="font-size:0.8rem;background:#f1f5f9;padding:2px 8px;border-radius:4px;color:#6366f1;">{{ f.owasp_id }}</span>{% endif %}
      {% if f.cwe_id %}<span style="font-size:0.8rem;color:#94a3b8;">{{ f.cwe_id }}</span>{% endif %}
    </div>
    <div class="finding-title">{{ f.title }}</div>
    {% if f.endpoint_method and f.endpoint_path %}
    <div class="finding-endpoint">{{ f.endpoint_method }} {{ f.endpoint_path }}</div>
    {% endif %}

    <div class="finding-section">
      <label>Description</label>
      <p>{{ f.description }}</p>
    </div>
    <div class="finding-section">
      <label>Business Impact</label>
      <p>{{ f.business_impact }}</p>
    </div>
    <div class="finding-section">
      <label>Remediation</label>
      <p>{{ f.remediation }}</p>
    </div>
    {% if f.evidence_request %}
    <div class="finding-section">
      <label>Evidence — Request</label>
      <pre>{{ f.evidence_request }}</pre>
    </div>
    {% endif %}
    {% if f.evidence_response %}
    <div class="finding-section">
      <label>Evidence — Response</label>
      <pre>{{ f.evidence_response }}</pre>
    </div>
    {% endif %}
    {% if f.references %}
    <div class="finding-section">
      <label>References</label>
      <ul style="list-style:none;margin-top:4px;">
      {% for ref in f.references %}
        <li style="font-size:0.82rem;"><a href="{{ ref }}" style="color:#6366f1;">{{ ref }}</a></li>
      {% endfor %}
      </ul>
    </div>
    {% endif %}
  </div>
  {% else %}
  <p style="color:#64748b;">No findings were detected in this scan.</p>
  {% endfor %}
</div>

<!-- Endpoint Inventory -->
<div class="section">
  <h2>Appendix — Endpoint Inventory ({{ endpoints | length }})</h2>
  <table>
    <thead><tr><th>Method</th><th>Path</th><th>Auth Required</th><th>Summary</th></tr></thead>
    <tbody>
    {% for ep in endpoints %}
    <tr>
      <td><strong>{{ ep.method }}</strong></td>
      <td><code>{{ ep.path }}</code></td>
      <td>{{ 'Yes' if ep.requires_auth else 'No' }}</td>
      <td>{{ ep.summary or '—' }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
</div>

<div class="section" style="text-align:center;color:#94a3b8;font-size:0.85rem;">
  Generated by API VAPT Tool v1.0 — {{ generated_at }}<br>
  This report is confidential. Unauthorized disclosure is prohibited.
</div>

</body>
</html>
